# Production MP3 chord API. Server-only; never expose this key to the browser.
CHORD_ENGINE_PROVIDER=klangio
KLANGIO_API_KEY=
KLANGIO_API_URL=https://api.klang.io
KLANGIO_VOCABULARY=full
KLANGIO_EXTENDED=true
KLANGIO_TIMEOUT_MS=270000
KLANGIO_POLL_INTERVAL_MS=2500

# Optional self-hosted ChordMini fallback.
CHORDMINI_API_URL=http://localhost:5001
CHORD_ENGINE_DETECTOR=chord-cnn-lstm
CHORD_ENGINE_DICT=full

# Local transcription worker (development defaults to 127.0.0.1:8771).
# Configure explicitly only after deploying an authenticated model service.
FRETFLOW_WORKER_URL=
FRETFLOW_WORKER_TOKEN=

# Set to 1 on both the website and worker for signed browser sessions.
FRETFLOW_HOSTED=0
# Worker-only pilot controls (see docs/HOSTING-500-US.md).
FRETFLOW_ALLOWED_ORIGINS=https://fretflow-ui.vercel.app,https://fretflow.io,https://www.fretflow.io
FRETFLOW_MAX_DURATION=180
FRETFLOW_MAX_UPLOAD_MIB=95
