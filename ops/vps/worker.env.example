# Install as /etc/fretflow/worker.env, owned by root with mode 600.
# Transfer the existing worker token privately; never commit the real file.
FRETFLOW_WORKER_TOKEN=
FRETFLOW_HOSTED=1
FRETFLOW_ALLOWED_ORIGINS=https://fretflow.io,https://www.fretflow.io,https://fretflow-ui.vercel.app
FRETFLOW_MAX_DURATION=60
FRETFLOW_MAX_UPLOAD_MIB=95
FRETFLOW_DAILY_TOTAL=50
FRETFLOW_DAILY_PER_USER=2
