[Unit]
Description=FretFlow transcription worker
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=fretflow
Group=fretflow
WorkingDirectory=/opt/fretflow-worker
EnvironmentFile=/etc/fretflow/worker.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PATH=/opt/fretflow-worker/.venv-audio/bin:/usr/local/bin:/usr/bin:/bin
Environment=FRETFLOW_RUNTIME=/var/lib/fretflow-worker/jobs
Environment=XDG_CACHE_HOME=/var/cache/fretflow-worker
Environment=NUMBA_CACHE_DIR=/var/cache/fretflow-worker/numba
Environment=TORCH_HOME=/var/cache/fretflow-worker/torch
Environment=OMP_NUM_THREADS=2
Environment=OPENBLAS_NUM_THREADS=2
Environment=MKL_NUM_THREADS=2
Environment=NUMBA_NUM_THREADS=2
ExecStart=/opt/fretflow-worker/.venv-audio/bin/python -m uvicorn backend.app:app --host 127.0.0.1 --port 8771 --workers 1 --no-access-log
Restart=always
RestartSec=5
TimeoutStopSec=120
KillMode=control-group
StateDirectory=fretflow-worker
StateDirectoryMode=0700
CacheDirectory=fretflow-worker
CacheDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
